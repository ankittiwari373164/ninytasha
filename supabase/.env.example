# Server secrets for the Supabase functions. They stay on Supabase and are never sent to the browser.
# Copy to supabase/.env, fill in, then run:   npx supabase secrets set --env-file supabase/.env

# ---- Admin login ----
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=use-a-long-unique-password

# ---- Razorpay (Dashboard → Account & Settings → API Keys) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Any long random text — paste the same value in Razorpay → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=make-up-a-long-random-string

# ---- Shiprocket (Settings → API → Configure / Create API User — NOT your normal login) ----
SHIPROCKET_EMAIL=api-user@yourdomain.com
SHIPROCKET_PASSWORD=api-user-password
# Pickup address nickname exactly as in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Warehouse
SHIPROCKET_PICKUP_PINCODE=110033
# Default carton size in cm (length x breadth x height)
SHIPROCKET_BOX_CM=25x20x15
# Any long random text — paste the same value in Shiprocket → Settings → API → Webhooks → Token
SHIPROCKET_WEBHOOK_TOKEN=make-up-another-long-random-string
# true = paid online orders are sent to Shiprocket automatically (COD orders: use "Send to Shiprocket" in admin)
SHIPROCKET_AUTO_CREATE=true
