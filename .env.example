# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay → Settings → API Keys (public key id only; secret goes in the Supabase edge function)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# WhatsApp number for COD confirmations, with country code, no +
VITE_WHATSAPP_NUMBER=919821412506

# ---------------------------------------------------------------
# ADMIN LOGIN
# Live (Supabase): the admin email/password are SERVER secrets, NOT in this file,
# because every VITE_ variable is visible in the public website code. Set them with:
#   npx supabase secrets set ADMIN_EMAIL=you@company.com ADMIN_PASSWORD='a-long-password'
#
# Demo mode only (no Supabase keys above): a throwaway login for local testing.
VITE_DEMO_ADMIN_EMAIL=admin@demo.com
VITE_DEMO_ADMIN_PASSWORD=change-me
